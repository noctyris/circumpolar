# PostgreSQL — POSTGRES_URL est prioritaire, DATABASE_URL sert de compatibilité.
POSTGRES_URL=postgresql://user:password@localhost:5432/circumpolar
# DATABASE_URL=postgresql://user:password@localhost:5432/circumpolar
# Mettre false pour un PostgreSQL local sans TLS.
POSTGRES_SSL=require
POSTGRES_POOL_MAX=10

# Auth.js v5 : AUTH_SECRET est la variable recommandée.
# Générer avec : openssl rand -base64 32
AUTH_SECRET=replace-me
# NEXTAUTH_SECRET=replace-me

# URL publique utilisée par le sitemap, le RSS et les métadonnées.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=circumpolar
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_MAX_UPLOAD_BYTES=10000000
